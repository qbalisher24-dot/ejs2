<%- include("navbar") %>

<!-- Karusel -->
<div id="karusel" class="carousel slide" data-bs-ride="carousel">
  <div class="carousel-inner">
    <div class="carousel-item active">
      <img src="https://picsum.photos/id/1/1200/350" class="d-block w-100">
    </div>
    <div class="carousel-item">
      <img src="https://picsum.photos/id/2/1200/350" class="d-block w-100">
    </div>
  </div>
  <button class="carousel-control-prev" data-bs-target="#karusel" data-bs-slide="prev">
    <span class="carousel-control-prev-icon"></span>
  </button>
  <button class="carousel-control-next" data-bs-target="#karusel" data-bs-slide="next">
    <span class="carousel-control-next-icon"></span>
  </button>
</div>

<div class="container mt-4">

  <!-- Admin formasi: faqat token role = admin bo'lsa ko'rinadi -->
  <form id="form" class="d-none gap-2 mb-2">
    <input name="title" class="form-control" placeholder="Nomi" required>
    <input name="desc" class="form-control" placeholder="Tavsif">
    <input name="price" type="number" class="form-control" placeholder="Narxi" required>
    <button class="btn btn-success">Qo'shish</button>
  </form>
  <p id="msg" class="text-danger"></p>

  <!-- Mahsulotlar: data/product.json dan backend chiqaradi -->
  <div class="row">
    <% if (products.length === 0) { %>
      <p>Hozircha mahsulot yo'q</p>
    <% } %>
    <% products.forEach(p => { %>
      <div class="col-4 mb-3">
        <div class="card p-3">
          <h5><%= p.title %></h5>
          <p><%= p.desc %></p>
          <p class="fw-bold"><%= p.price %> so'm</p>
          <button class="btn btn-primary">Sotib olish</button>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<script>
  if (me && me.role === "admin") form.classList.replace("d-none", "d-flex")

  form.onsubmit = async (e) => {
    e.preventDefault()
    const body = Object.fromEntries(new FormData(form))
    body.price = Number(body.price)
    const { ok, data } = await api("/add_product", body) // Bearer token bilan
    if (!ok) return (msg.textContent = data.message)
    location.reload()
  }
</script>
