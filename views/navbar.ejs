<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<nav class="navbar navbar-dark bg-dark px-4">
  <a class="navbar-brand" href="/">MiniShop</a>
  <div id="nav-buttons">
    <a href="/login" class="btn btn-outline-light">Login</a>
    <a href="/register" class="btn btn-warning">Register</a>
  </div>
</nav>

<script>
  // /verify qaytargan token localStorage'da turadi
  const token = localStorage.getItem("token")
  // Token ichidagi ma'lumot (id, email, role) — o'rtadagi qismi
  const me = token ? JSON.parse(atob(token.split(".")[1])) : null

  if (me) {
    document.getElementById("nav-buttons").innerHTML = `
      <span class="text-white me-2">${me.email} (${me.role})</span>
      <button class="btn btn-outline-light" onclick="localStorage.removeItem('token'); location.href='/'">Chiqish</button>`
  }

  // Formani JSON qilib API'ga yuborish uchun yordamchi
  async function api(url, data) {
    const res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
      body: JSON.stringify(data)
    })
    return { ok: res.ok, data: await res.json() }
  }
</script>
